# Copy to .env to override defaults used by docker-compose.yml.
PORT=8000
# true installs PyTorch + BGE-M3 for semantic retrieval (bigger image, ~2.5 GB model download on first run)
INSTALL_ML=false
# PyPI mirror if downloads from files.pythonhosted.org fail (SSL EOF / timeouts)
PIP_INDEX_URL=https://pypi.org/simple
ISRE_DENSE=auto
ISRE_RERANK_MODEL=
ISRE_OLLAMA_MODEL=
ISRE_ABSTAIN_THRESHOLD=0.30
ISRE_LOG_LEVEL=INFO
ISRE_LOG_RETENTION_DAYS=30
